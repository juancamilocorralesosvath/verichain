{
  "name": "@bc/core",
  "version": "0.1.0",
  "private": true,
  "description": "Lógica criptográfica compartida (serialización canónica, hashes, PoW, verificación). Isomórfica: corre en Node y en el navegador.",
  "type": "module",
  "main": "./dist/index.js",

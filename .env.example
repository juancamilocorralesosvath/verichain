# Copia este archivo como .env y llena los valores. .env NUNCA se sube al repo.

# --- API ---
PORT=3000
# Origen permitido por CORS (el frontend)
WEB_ORIGIN=http://localhost:5173
# Ruta de la base de datos SQLite (Prisma)
DATABASE_URL=file:./data/blockchain.db

# --- Autenticación (H3.1) ---
# Genera con: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
JWT_EXPIRES_IN=15m
# Admin inicial creado por el seed
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Confidencialidad (H4.1) ---
# Llave AES-256 en base64 (32 bytes). Genera con:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_KEY=

# --- Sello del servidor (H5.4) ---
# Llave privada ECDSA P-256 del servidor (fuera de la BD). Sin ella la API no arranca.
# La ruta es relativa a apps/api. Genérala con: npm run llaves:servidor -w @bc/api
# (crea también server-public.pem a su lado y no sobrescribe llaves existentes).
SERVER_SIGNING_KEY_PATH=./secrets/server-signing-key.pem

# --- Prueba de trabajo (H1.3 / H5.3) ---
POW_DIFFICULTY=4

# --- Demo (H6.1) ---
# Habilita el módulo de ataques. Solo en demo, nunca en producción.
DEMO_MODE=false

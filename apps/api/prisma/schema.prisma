generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Usuario {
  id            Int            @id @default(autoincrement())
  username      String         @unique
  password_hash String
  rol           String
  activo        Boolean        @default(true)
  creado_en     DateTime       @default(now())
  llaves        LlaveUsuario[]
  borradores    Borrador[]
}

/// Llave pública ECDSA P-256 de un usuario. Las llaves viejas nunca se borran (§7b).
model LlaveUsuario {
  id           Int       @id @default(autoincrement())
  usuario_id   Int
  usuario      Usuario   @relation(fields: [usuario_id], references: [id])
  version      Int
  spki_b64     String    @unique
  estado       String // pendiente | aprobada | reemplazada | rechazada
  creado_en    DateTime  @default(now())
  aprobada_por Int?
  aprobada_en  DateTime?

  @@unique([usuario_id, version])
}

/// Registro preparado que espera la firma del usuario (§5.3). Expira en 5 minutos.
model Borrador {
  id         String   @id @default(uuid())
  usuario_id Int
  usuario    Usuario  @relation(fields: [usuario_id], references: [id])
  fila_json  String // la FilaPersona ya cifrada: el hash incluye el texto cifrado
  hash_datos String
  expira_en  DateTime
}

/// Sello del servidor: firma ECDSA sobre `${indice}:${hash_cadena}` del último bloque (§5.4).
/// Histórico: el vigente es el de mayor id.
model Sello {
  id          Int      @id @default(autoincrement())
  indice      Int
  hash_cadena String
  firma       String
  creado_en   DateTime @default(now())
}

/// Bitácora de auditoría append-only, encadenada con hash (§5.10). Solo se escribe con BitacoraService.
model Bitacora {
  id        Int    @id @default(autoincrement())
  fecha     String // ISO UTC con ms
  usuario   String
  accion    String
  resultado String // ok | fallo
  ip        String
  detalle   String
  hash      String
}

model Persona {
  id                Int     @id @default(autoincrement())
  cedula            String  @unique
  nombre            String
  direccion_cifrada String
  telefono_cifrado  String
  creado_en         String // ISO UTC con ms, exactamente el que se hasheó
  creado_por        String
  bloque            Bloque?
}

model Bloque {
  indice        Int      @id // 0 = génesis
  persona_id    Int?     @unique
  persona       Persona? @relation(fields: [persona_id], references: [id])
  hash_datos    String
  nonce         Int
  hash_anterior String
  hash_cadena   String
  firma_usuario String?
  llave_id      Int?
  creado_en     String
}
